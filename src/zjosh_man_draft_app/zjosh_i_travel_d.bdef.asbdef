managed ;
strict ( 2 );

define behavior for zjosh_i_travel_D //alias <alias_name>
implementation in class zbp_josh_i_travel_d unique
persistent table zjosh_a_travel_t
lock master
authorization master ( instance, global )
//etag master <field_name>
{
  create ( precheck );
  update ( precheck );
  delete;
  field ( numbering :managed, readonly  ) TravelUUID;
  association _Booking { create; }

  action( authorization :update ) acceptTravel result [1] $self;
  action( authorization :update ) rejectTravel result [1] $self;
  action( authorization :update ) deductDiscount parameter zjosh_absten_dedacti result [1] $self;
  internal action recalcTotalPrice;

  mapping for zjosh_a_travel_t{

   AgencyID = agency_id;
   BeginDate = begin_date;
   BookingFee = booking_fee;
   CurrencyCode = currency_code;
   CustomerID = customer_id;
   Description = description;
   EndDate = end_date;
   LastChangedAt = last_changed_at;
   LocalCreatedAt = local_created_at;
   LocalCreatedBy = local_created_by;
   LocalLastChangedAt = local_last_changed_at;
   LocalLastChangedBy = local_last_changed_by;
   OverallStatus = overall_status;
   TotalPrice = total_price;
   TravelID = travel_id;
   TravelUUID = travel_uuid;

  }


}

