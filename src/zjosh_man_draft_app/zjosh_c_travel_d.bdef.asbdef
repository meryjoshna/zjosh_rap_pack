projection;
strict ( 2 );

use side effects;
use draft;
define behavior for zjosh_c_travel_D //alias <alias_name>
{
  use create;
  use update;
  use delete;

  use action deductDiscount;
  use action acceptTravel;
  use action rejectTravel;
  use association _Booking { create; with draft; }

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

}

define behavior for zjosh_c_bookg_D //alias <alias_name>
{
  use update;
  use delete;

  use association _Travel {with draft;}
  use association _BookingSupplement { create; with draft; }
}

define behavior for zjosh_c_bsupp_d //alias <alias_name>
{
  use update;
  use delete;

  use association _Travel { with draft; }
  use association _Booking { with draft; }
}